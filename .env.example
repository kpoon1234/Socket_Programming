# คัดลอกเป็น .env ที่ root ของโปรเจกต์ แล้วแทนค่าตัวอย่างด้านล่าง
# ใช้เฉพาะเครื่อง Server และไม่ commit .env ที่มี key จริง
GROQ_API_KEY=your_groq_api_key_here

# โมเดลสำหรับสรุปแชต เปลี่ยนเป็น model ID ที่บัญชีเรียกใช้ได้
GROQ_MODEL=openai/gpt-oss-20b

# feature/summarize/ai_summarize.py อ่าน .env เมื่อเรียกสรุป
# environment ที่ตั้งไว้มีสิทธิ์เหนือค่าในไฟล์นี้
